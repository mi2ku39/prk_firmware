MRuby::GemBox.new do |conf|
  # Gems that were removed from picoruby upstream live next to this gembox
  prk_gems = File.dirname(MRuby::GemBox.path)

  conf.gem core: 'mruby-compiler'
  conf.gem core: 'picoruby-mrubyc'
  conf.gem core: "picoruby-require"
  conf.gem core: 'picoruby-vfs'
  conf.gem "#{prk_gems}/picoruby-filesystem-fat"
  conf.gem core: 'picoruby-numeric-ext'
  conf.gem "#{prk_gems}/picoruby-music-macro-language"
  conf.gem "#{prk_gems}/picoruby-prk-consumer_key"
  conf.gem "#{prk_gems}/picoruby-prk-debounce"
  conf.gem "#{prk_gems}/picoruby-prk-joystick"
  conf.gem "#{prk_gems}/picoruby-prk-mouse"
  conf.gem "#{prk_gems}/picoruby-prk-keyboard"
  conf.gem "#{prk_gems}/picoruby-prk-rgb"
  conf.gem "#{prk_gems}/picoruby-prk-rotary_encoder"
  conf.gem "#{prk_gems}/picoruby-prk-sounder"
  conf.gem "#{prk_gems}/picoruby-prk-via"
  conf.gem core: 'picoruby-i2c'
  conf.gem core: 'picoruby-spi'
  conf.gem core: 'picoruby-adc'
  conf.gem core: 'picoruby-pwm'
  conf.gem core: "picoruby-watchdog"
  conf.gem core: "picoruby-machine"
  conf.gem core: "picoruby-picorubyvm"
end
